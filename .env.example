# Optional public demo using a dedicated platform credential. Disabled by default.
LLM_ENABLE_PLATFORM_MODELS=false
# OpenAI-compatible endpoint. Include the /v1 prefix when the provider uses it.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional. When empty, the server list is the single LLM_BASE_URL / LLM_API_KEY / LLM_MODEL item with gateway false.
# JSON array of {"id","label","baseUrl","apiKey","gateway"}. Real values belong in .env or EdgeOne env, not here.
LLM_MODELS=

AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# PocketBase. Local development: http://127.0.0.1:8090
# Edge functions record usage only when PB_URL is an address they can reach. 127.0.0.1 is for local development.
PB_URL=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# Personal API Key encryption (32 random bytes in hex). Keep stable and private.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MODEL_PROVIDER_ENCRYPTION_KEY=
